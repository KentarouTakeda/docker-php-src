{
  "name": "php-src",

  "dockerComposeFile": ["../compose.yml"],

  "service": "build",
  "updateRemoteUserUID": false,

  "workspaceFolder": "/home/build/php-src",

  "postAttachCommand": "git config --global core.excludesfile /home/build/gitignore",

  "customizations": {
    "vscode": {
      "settings": {
        "launch": {
          "version": "0.2.0",
          "configurations": [
            {
              "name": "php (gdb)",
              "type": "cppdbg",
              "request": "launch",
              "program": "${workspaceFolder}/sapi/cli/php",
              "args": ["${input:phpScript}"],
              "cwd": "${workspaceFolder}",
              "MIMode": "gdb",
              "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
              ]
            }
          ],
          "inputs": [
            {
              "id": "phpScript",
              "type": "promptString",
              "description": "PHP script to run",
              "default": "/tmp/t.php"
            }
          ]
        },

        "files.associations": {
          "*.h": "c",
          "*.phpt": "php"
        },

        // cpptools stays for cppdbg.
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}"
        ],

        "diffEditor.ignoreTrimWhitespace": false,
        "editor.detectIndentation": false,
        "editor.insertSpaces": false,
        "editor.renderWhitespace": "boundary",
        "editor.tabSize": 4,
        "intelephense.environment.phpVersion": "8.6.0",

        "intelephense.files.exclude": [
          "**/.git/**",
          "**/.svn/**",
          "**/.hg/**",
          "**/CVS/**",
          "**/.DS_Store/**",
          "**/node_modules/**",
          "**/bower_components/**",
          "**/vendor/**/{Tests,tests}/**",
          "**/.history/**",
          "**/vendor/**/vendor/**",
          "**/build/**"
        ],
        "files.watcherExclude": {
          "**/.libs/**": true,
          "**/*.lo": true,
          "**/*.o": true,
          "**/autom4te.cache/**": true
        },

        "php.suggest.basic": false,
        "php.validate.enable": false,

        // Generated; floods search results.
        "search.exclude": {
          "Zend/zend_vm_execute.h": true
        },
        "search.useGlobalIgnoreFiles": true
      },

      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "eamodio.gitlens",
        "llvm-vs-code-extensions.vscode-clangd",
        "EditorConfig.EditorConfig",
        "maelvalais.autoconf",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-vscode.cpptools"
      ]
    }
  }
}
